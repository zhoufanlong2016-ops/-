          "source_block": 18,
          "candidate_block": 9,
          "candidate_line_count": 3,
          "center_error": 22.193,
          "text": "Article 5 The Business Development Department is the management department for\nthe company's domestic project business operations, responsible for the layout and\ndevelopment of the institute's business market."
