        {
          "page": 1,
          "source_size": 11.04,
          "size": 10.0,
          "text": "项目范围"
        },
        {
          "page": 1,
          "source_size": 12.0,
          "size": 11.0,
          "text": "通过MTBM敷设主干污水管："
        },
        {
          "page": 1,
          "source_size": 12.0,
          "size": 11.0,
          "text": "Line A：LARECHs Colony至Qartaba Chowk, Lahore（含管道直径1050、1500及2"
        },
        {
          "page": 1,
          "source_size": 12.0,
          "size": 11.0,
          "text": "Line B：Gurumangat至Qartaba Chowk, Lahore（含管道直径1050、1500、2400m"
